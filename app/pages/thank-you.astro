---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
---

<BaseLayout title="Thank You">
  <section class="max-w-2xl mx-auto px-4 py-32 text-center">
    <span class="text-5xl">✅</span>
    <h1 class="text-3xl font-bold text-blue-950 mt-6 mb-4">Message Sent!</h1>
    <p class="text-gray-600 mb-8">
      Thanks for reaching out. We'll get back to you as soon as possible.
    </p>
    <div class="flex justify-center gap-4">
      
       <a href="/"
        class="bg-blue-900 hover:bg-blue-800 text-white font-bold px-8 py-3 rounded-lg transition-colors"
      >
        Back to Home
      </a>
      
      <a  href="/tours"
        class="border-2 border-blue-900 text-blue-900 hover:bg-blue-900 hover:text-white font-bold px-8 py-3 rounded-lg transition-colors"
      >
        View Tours
      </a>
    </div>
  </section>
</BaseLayout>