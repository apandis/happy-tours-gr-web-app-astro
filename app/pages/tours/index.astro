---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import TourCard from "../../components/TourCard.astro";

const tours = (await getCollection("tours")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<BaseLayout title="Our Tours" description="Explore all our fishing tours and boat trips from Kavos, Corfu">
  <PageHeader
    title="Our Tours"
    subtitle="Choose the perfect tour for your adventure"
  />

  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-3 gap-8">
      {tours.map((tour) => (
        <TourCard
          slug={tour.id}
          title={tour.data.title}
          description={tour.data.description}
          image={tour.data.image}
          price={tour.data.price}
          duration={tour.data.duration}
        />
      ))}
    </div>
  </section>
</BaseLayout>