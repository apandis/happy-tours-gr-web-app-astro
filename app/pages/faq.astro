---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { FAQS } from "../config/site";
---

<BaseLayout title="FAQ" description="Frequently asked questions about Happy Tours Kavos fishing tours and boat trips">
  <PageHeader
    title="Frequently Asked Questions"
    subtitle="Everything you need to know before your trip"
  />

  <section class="max-w-3xl mx-auto px-4 py-16">
    <div class="space-y-4">
      {FAQS.map((faq) => (
        <details class="group bg-white rounded-lg shadow-md">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 font-semibold text-blue-950">
            {faq.question}
            <span class="text-amber-500 transition-transform group-open:rotate-45 text-xl">+</span>
          </summary>
          <p class="px-6 pb-4 text-gray-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>