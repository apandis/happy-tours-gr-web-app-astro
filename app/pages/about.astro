---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE } from "../config/site";
---

<BaseLayout title="About Us" description={`Learn about ${SITE.name} — your local fishing tour experts in Kavos, Corfu`}>
  <PageHeader
    title="About Us"
    subtitle="Meet the crew behind your next adventure"
  />

  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <img
        src="/images/happy-tours-captain.png"
        alt="Our captain"
        class="rounded-lg shadow-md w-full h-80 object-cover"
      />
      <div>
        <h2 class="text-2xl font-bold text-blue-950 mb-4">Our Story</h2>
        <p class="text-gray-600 mb-4">
          Born and raised in Corfu, we've spent our lives on these waters. What started as a love for fishing and the sea turned into a mission — sharing the beauty of the Ionian coast with visitors from around the world.
        </p>
        <p class="text-gray-600">
          At {SITE.name}, every tour is personal. We keep our groups small so you get the real experience — not a crowded tourist boat, but a genuine day on the water with a local who knows every hidden cave, fishing spot, and secret beach.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-blue-950 text-white py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-10">Why Choose Us</h2>
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <span class="text-4xl">🎣</span>
          <h3 class="font-semibold text-lg mt-3 mb-2">Local Experience</h3>
          <p class="text-blue-300 text-sm">Our captain knows every fishing spot, hidden beach, and sea cave along the coast.</p>
        </div>
        <div>
          <span class="text-4xl">👨‍👩‍👧‍👦</span>
          <h3 class="font-semibold text-lg mt-3 mb-2">Small Groups</h3>
          <p class="text-blue-300 text-sm">We keep our tours intimate so every guest gets a personal, hands-on experience.</p>
        </div>
        <div>
          <span class="text-4xl">⭐</span>
          <h3 class="font-semibold text-lg mt-3 mb-2">5-Star Rated</h3>
          <p class="text-blue-300 text-sm">Loved by hundreds of visitors — check our reviews on Google and TripAdvisor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-blue-950 mb-4">Ready to Come Aboard?</h2>
    <p class="text-gray-600 mb-8">Book your tour today and experience the best of Corfu's coastline with us.</p>
    <div class="flex justify-center gap-4">
      
      <a  href="/tours"
        class="bg-blue-900 hover:bg-blue-800 text-white font-bold px-8 py-3 rounded-lg transition-colors"
      >
        View Tours
      </a>
      
      <a  href="/contact"
        class="border-2 border-blue-900 text-blue-900 hover:bg-blue-900 hover:text-white font-bold px-8 py-3 rounded-lg transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>