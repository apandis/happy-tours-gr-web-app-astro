---
import { HIGHLIGHTS } from "../config/site";

const icons = ["🎣", "🍹", "🏝️"];
---

<section class="bg-blue-950 text-white py-16">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-10">Why Happy Tours?</h2>
    <div class="grid md:grid-cols-3 gap-8 text-center">
      {HIGHLIGHTS.map((item, index) => (
        <div class="bg-blue-900/50 rounded-lg p-8">
          <span class="text-4xl">{icons[index]}</span>
          <h3 class="font-semibold text-lg mt-4 mb-2">{item.title}</h3>
          <p class="text-blue-300 text-sm">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>