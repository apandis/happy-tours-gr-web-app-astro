---
import { SITE, NAV_LINKS } from "../config/site";
---

<footer class="bg-blue-950 text-white pt-12 pb-6">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8">

      <div>
        <a href="/" class="text-2xl font-bold tracking-tight">{SITE.name}</a>
        <p class="mt-3 text-blue-300 text-sm">{SITE.tagline}</p>
      </div>

      <div>
        <h3 class="font-semibold text-lg mb-3">Quick Links</h3>
        <ul class="space-y-2">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-blue-300 hover:text-amber-400 transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-lg mb-3">Contact Us</h3>
        <ul class="space-y-2 text-sm text-blue-300">
          <li>
            <a href={`tel:${SITE.phoneRaw}`} class="hover:text-amber-400 transition-colors">
              📞 {SITE.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-amber-400 transition-colors">
              ✉️ {SITE.email}
            </a>
          </li>
          <li>📍 {SITE.location}</li>
        </ul>
        <div class="flex gap-4 mt-4">
          <a href={SITE.socials.instagram} target="_blank" class="text-blue-300 hover:text-amber-400 transition-colors">Instagram</a>
          <a href={SITE.socials.facebook} target="_blank" class="text-blue-300 hover:text-amber-400 transition-colors">Facebook</a>
          <a href={SITE.socials.googleMaps} target="_blank" class="text-blue-300 hover:text-amber-400 transition-colors">Maps</a>
        </div>
      </div>

    </div>

    <div class="border-t border-blue-800 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center text-sm text-blue-400">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <div class="flex gap-4 mt-2 md:mt-0">
        <a href="/privacy-policy" class="hover:text-amber-400 transition-colors">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-amber-400 transition-colors">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>